# Copia este archivo como .env en cada VM y ajusta los valores.
# El .env no se sube al repositorio (está en .gitignore).

# Qué corre esta VM.
#   vm-01:                 controlnode,datanode
#   vm-02, vm-03 y vm-04:  datanode
COMPOSE_PROFILES=controlnode,datanode

# Clave compartida del clúster. Debe ser la misma en todas las VMs.
CLUSTER_KEY=cambia-esta-clave

# IP privada de vm-01, donde corre el ControlNode.
CONTROLNODE_HOST=10.0.1.11

# Identidad del DataNode de esta VM: dn-01, dn-02, dn-03 o dn-04.
DATANODE_ID=dn-01

# Dirección con la que el cliente y los otros DataNodes alcanzan a este
# DataNode. Si el cliente corre dentro de la misma red de AWS, la IP privada
# de esta VM; si corre desde fuera (por ejemplo, un portátil), la IP pública.
ADVERTISE_HOST=10.0.1.11

# Puerto del DataNode y carpeta donde guarda los bloques (el volumen de 20 GB).
DATANODE_PORT=8001
BLOCKS_DIR=/srv/dfsha/blocks
