# Ejemplo de tres EC2 en la MISMA VPC. Cambiar todas las IP por las reales.
# node1.env: CN_ID=cn-01,DN_ID=dn-01,PRIVATE_IP=IP1
# node2.env: CN_ID=cn-02,DN_ID=dn-02,PRIVATE_IP=IP2
# node3.env: CN_ID=cn-03,DN_ID=dn-03,PRIVATE_IP=IP3
CN_ID=cn-01
DN_ID=dn-01
PRIVATE_IP=10.0.1.10
CN_PEERS=cn-01@10.0.1.10:9000@https://10.0.1.10:8000,cn-02@10.0.1.11:9000@https://10.0.1.11:8000,cn-03@10.0.1.12:9000@https://10.0.1.12:8000
CONTROL_URLS=https://10.0.1.10:8000,https://10.0.1.11:8000,https://10.0.1.12:8000
DATA_ROOT=/var/lib/dfsha
CAPACITY_BYTES=1073741824
REPLICATION_FACTOR=2
