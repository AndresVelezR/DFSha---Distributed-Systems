# Configuración de una VM. Copiar como vm1.env, vm2.env, vm3.env (y vm4.env si
# se agrega un cuarto DataNode) y cambiar las IP por las privadas reales.
# CN_PEERS y CONTROL_URLS son iguales en todas las VMs; solo cambian las
# tres primeras líneas.

CN_ID=cn-01
DN_ID=dn-01
PRIVATE_IP=172.31.0.11

CN_PEERS=cn-01@172.31.0.11:9000@https://172.31.0.11:8000,cn-02@172.31.0.12:9000@https://172.31.0.12:8000,cn-03@172.31.0.13:9000@https://172.31.0.13:8000
CONTROL_URLS=https://172.31.0.11:8000,https://172.31.0.12:8000,https://172.31.0.13:8000

# Carpeta del disco de la VM donde quedan metadatos y bloques.
DATA_ROOT=/var/lib/dfsha
# Espacio que el DataNode ofrece al clúster (1 GiB). Debe caber en el disco.
CAPACITY_BYTES=1073741824
