# Copiar a .env si se quieren cambiar límites; no contiene credenciales.
REPLICATION_FACTOR=2
BLOCK_SIZE_MIN_MB=8
BLOCK_SIZE_MAX_MB=64
BLOCKS_PER_NODE=4
HEARTBEAT_MS=3000
HEARTBEAT_MISSES=3
REPORT_MS=30000
WRITE_LEASE_SECONDS=60
MAINTENANCE_MS=5000
GC_GRACE_SECONDS=120
FULL_THRESHOLD_PERCENT=90
REBALANCE_THRESHOLD_PERCENT=10
CAPACITY_BYTES=1073741824
# Cliente nativo contra el despliegue AWS/VPN, o clúster nativo de pruebas:
# DFSHA_CONTROLS=https://10.0.1.10:8000,https://10.0.1.11:8000,https://10.0.1.12:8000
# DFSHA_CA=.secrets/ca.crt
# DFSHA_SESSION=.local-session/session.json
# Compose ya establece estas variables dentro de client. Los planes locales
# anuncian DNS de Docker (dn1/dn2/dn3): usa docker compose run --rm client.
# Los secretos se generan con scripts/setup.py y se montan mediante *_FILE.
